@@ -1208,6 +1208,13 @@
 	if (preserve_gid) {
 		F_GROUP(file) = gid;
 		file->flags |= gid_flags;
+		/* mac-rsync-patch phase 2: under --chown/
+		 * --groupmap only regular files take the mapped group.  Marking
